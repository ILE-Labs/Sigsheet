+// Sigsheet (path C, design-stage patch for experiment X6): read, sign, merge and finalize a shared multisig file.
+// Throwaway experiment code, not a proposal to CCC. Signing goes through CCC's own signers.
+import { Cell, Script, Transaction, WitnessArgs } from "../ckb/index.js";
+import { Client } from "../client/index.js";
+import { JsonRpcTransformers } from "../client/jsonRpc/transformers.js";
+import type { JsonRpcTransaction } from "../client/jsonRpc/types.js";
+import { bytesFrom } from "../bytes/index.js";
+import { hashCkbShort } from "../hasher/index.js";
+import { Hex, hexFrom } from "../hex/index.js";
+import {
+  MultisigCkbWitness,
+  recoverMessageSecp256k1,
+  SignerCkbPrivateKey,
+  SignerMultisigCkbPrivateKey,
+  SignerMultisigCkbReadonly,
+} from "../signer/index.js";
+
+export type SigsheetConfig = { public_key_hashes: Hex[]; require_first_n: number; threshold: number };
+export type SigsheetJson = {
+  version: "0x1";
+  transaction: JsonRpcTransaction;
+  context: Record<string, Omit<JsonRpcTransaction, "witnesses">>;
+  multisig_configs: Record<string, SigsheetConfig>;
+  signatures: Record<string, Record<string, Hex>>;
+};
+
+const TOP = ["context", "multisig_configs", "signatures", "transaction", "version"];
+const N = 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141n;
+const SIGHASH = "0x9bd7e06f3ecf4be0f2fcd2188b23f1b9fcc88e5d4b65a8637b17723bbda3cce8";
+// The three multisig deployments (mainnet/testnet code hashes); callers may add others (a devnet's 2024 type hash).
+const MULTISIG = [
+  "0x5c5069eb0857efc65e1bca0c07df34c31663b3622fd3876c876320fc9634e2a8/type",
+  "0xd1a9f877aed3f5e07cb9c52b61ab96d06f250ae6883cc7f0a2423db0976fc821/type",
+  "0x765b3ed6ae264b335d07e73ac332bf2c0f38f8d3340ed521cb447b4c42dd5f09/type",
+  "0x36c971b8d41fbd94aabca77dc75e826729ac98447b46f91e00796155dddb0d29/data1",
+];
+
+/** RFC 8785 for the values a Sigsheet holds (ASCII strings, small integers, objects, arrays). */
+export function sigsheetCanonicalJson(v: unknown): string {
+  if (v === null || typeof v !== "object") return JSON.stringify(v);
+  if (Array.isArray(v)) return `[${v.map(sigsheetCanonicalJson).join(",")}]`;
+  const o = v as Record<string, unknown>;
+  return `{${Object.keys(o)
+    .sort()
+    .map((k) => `${JSON.stringify(k)}:${sigsheetCanonicalJson(o[k])}`)
+    .join(",")}}`;
+}
+
+function lowS(sig: Hex): Hex {
+  const b = bytesFrom(sig);
+  const s = BigInt(hexFrom(b.slice(32, 64)));
+  if (s <= N / 2n) return hexFrom(b);
+  const out = new Uint8Array(65);
+  out.set(b.slice(0, 32));
+  out.set(bytesFrom((N - s).toString(16).padStart(64, "0")), 32);
+  out[64] = b[64] ^ 1;
+  return hexFrom(out);
+}
+
+type Group = { script: Script; lockHash: Hex; kind: "multisig" | "sighash" | "unknown"; inputs: number[] };
+
+export class Sigsheet {
+  constructor(public doc: SigsheetJson, public extraMultisig: string[] = []) {}
+
+  static fromJson(text: string, extraMultisig: string[] = []): Sigsheet {
+    const doc = JSON.parse(text) as SigsheetJson;
+    if (Object.keys(doc).sort().join() !== TOP.join() || doc.version !== "0x1") {
+      throw new Error("not a Sigsheet v1 file");
+    }
+    if (sigsheetCanonicalJson(doc) !== text) throw new Error("Sigsheet file not in canonical form");
+    return new Sigsheet(doc, extraMultisig);
+  }
+
+  toJson(): string {
+    return sigsheetCanonicalJson(this.doc);
+  }
+
+  /** A transaction in CKB RPC JSON, for sending. */
+  static toRpcTransaction(tx: Transaction): JsonRpcTransaction {
+    return JsonRpcTransformers.transactionFrom(tx);
+  }
+
+  /** The unsigned transaction, with the witness templates. */
+  template(): Transaction {
+    return JsonRpcTransformers.transactionTo(this.doc.transaction);
+  }
+
+  /** Put every spent cell, taken from the carried previous transactions (checked by hash), in the client's cache. */
+  async recordContext(client: Client): Promise<void> {
+    const tx = this.template();
+    const cells: Cell[] = [];
+    for (const input of tx.inputs) {
+      const raw = this.doc.context[input.previousOutput.txHash];
+      if (!raw) throw new Error(`no previous transaction for ${input.previousOutput.txHash}`);
+      const prev = JsonRpcTransformers.transactionTo({ ...raw, witnesses: [] });
+      if (prev.hash() !== input.previousOutput.txHash) throw new Error("previous transaction doesn't match its hash");
+      const i = Number(input.previousOutput.index);
+      cells.push(
+        Cell.from({ outPoint: input.previousOutput, cellOutput: prev.outputs[i], outputData: prev.outputsData[i] }),
+      );
+    }
+    await client.cache.recordCells(cells);
+  }
+
+  async groups(client: Client): Promise<Map<Hex, Group>> {
+    const tx = this.template();
+    const out = new Map<Hex, Group>();
+    for (let i = 0; i < tx.inputs.length; i++) {
+      const { cellOutput } = await tx.inputs[i].getCell(client);
+      const lock = cellOutput.lock;
+      const id = `${lock.codeHash}/${lock.hashType}`;
+      const kind = MULTISIG.includes(id) || this.extraMultisig.includes(id)
+        ? "multisig" : id === `${SIGHASH}/type` ? "sighash" : "unknown";
+      const h = lock.hash();
+      if (!out.has(h)) out.set(h, { script: lock, lockHash: h, kind, inputs: [] });
+      out.get(h)!.inputs.push(i);
+    }
+    return out;
+  }
+
+  private multisigSigner(client: Client, g: Group, privateKey?: Hex) {
+    const args = bytesFrom(g.script.args);
+    const cfg = this.doc.multisig_configs[hexFrom(args.slice(0, 20))];
+    if (!cfg) throw new Error(`no multisig config for ${g.script.args}`);
+    const info = { publicKeyHashes: cfg.public_key_hashes, threshold: cfg.threshold, mustMatch: cfg.require_first_n };
+    const since = args.length === 28 ? new DataView(args.buffer, args.byteOffset + 20, 8).getBigUint64(0, true) : undefined;
+    const options = {
+      since: since === undefined ? undefined : since,
+      scriptInfos: [{ codeHash: g.script.codeHash, hashType: g.script.hashType, cellDeps: [] }],
+    };
+    return privateKey
+      ? new SignerMultisigCkbPrivateKey(client, privateKey, info, options)
+      : new SignerMultisigCkbReadonly(client, info, options);
+  }
+
+  /** The lock's message for a group, computed by CCC. */
+  async message(client: Client, g: Group): Promise<Hex> {
+    const tx = this.template();
+    if (g.kind === "multisig") {
+      const signer = this.multisigSigner(client, g);
+      if ((await signer.scriptInfos)[0].script.args !== g.script.args) throw new Error("config doesn't match the lock");
+      return (await signer.getSignInfo(tx, g.script))!.message;
+    }
+    const w = tx.getWitnessArgs(g.inputs[0]) ?? WitnessArgs.from({});
+    w.lock = hexFrom(new Uint8Array(65));
+    tx.setWitnessArgs(g.inputs[0], w);
+    return (await tx.getSignHashInfo(g.script, client))!.message;
+  }
+
+  /** Signer of a signature, if it is a member of the group (or the single-key lock's key). */
+  async signerOf(client: Client, g: Group, sig: Hex, msg?: Hex): Promise<Hex | undefined> {
+    if (bytesFrom(sig).length !== 65) return;
+    let kh: Hex;
+    try {
+      kh = hashCkbShort(recoverMessageSecp256k1(msg ?? (await this.message(client, g)), sig));
+    } catch {
+      return;
+    }
+    if (g.kind === "multisig") {
+      const cfg = this.doc.multisig_configs[hexFrom(bytesFrom(g.script.args).slice(0, 20))];
+      return cfg.public_key_hashes.includes(kh) ? kh : undefined;
+    }
+    return g.kind === "sighash" && kh === g.script.args ? kh : undefined;
+  }
+
+  private add(lockHash: Hex, kh: Hex, sig: Hex) {
+    const s = lowS(sig);
+    const box = (this.doc.signatures[lockHash] ??= {});
+    if (!box[kh] || s < box[kh]) box[kh] = s;
+  }
+
+  /** Sign every group this private key can sign, with CCC's own signers. Returns the number of signatures added. */
+  async sign(client: Client, privateKey: Hex): Promise<number> {
+    await this.recordContext(client);
+    let added = 0;
+    for (const g of (await this.groups(client)).values()) {
+      if (g.kind === "unknown") continue;
+      const tx = this.template();
+      let lock: Hex | undefined;
+      if (g.kind === "multisig") {
+        const signer = this.multisigSigner(client, g, privateKey) as SignerMultisigCkbPrivateKey;
+        const signed = await signer.signOnlyTransaction(tx.clone());
+        const w = signer.decodeWitnessArgsAt(signed, g.inputs[0]);
+        lock = w?.signatures.find((s) => s !== SignerMultisigCkbReadonly.EmptySignature);
+      } else {
+        const signer = new SignerCkbPrivateKey(client, privateKey);
+        if (hashCkbShort(signer.publicKey) !== g.script.args) continue;
+        const signed = await signer.signOnlyTransaction(tx.clone());
+        lock = signed.getWitnessArgs(g.inputs[0])?.lock;
+      }
+      if (!lock) continue;
+      const kh = await this.signerOf(client, g, lock);
+      if (kh) {
+        this.add(g.lockHash, kh, lock);
+        added += 1;
+      }
+    }
+    return added;
+  }
+
+  /** The merge rule: the same unsigned transaction; every verified member signature, low-s, keyed by signer. */
+  async merge(client: Client, ...others: Sigsheet[]): Promise<Sigsheet> {
+    const out = new Sigsheet(JSON.parse(this.toJson()), this.extraMultisig);
+    for (const o of others) {
+      if (sigsheetCanonicalJson(o.doc.transaction) !== sigsheetCanonicalJson(this.doc.transaction)) {
+        throw new Error("files describe different transactions");
+      }
+      Object.assign(out.doc.context, o.doc.context);
+      Object.assign(out.doc.multisig_configs, o.doc.multisig_configs);
+    }
+    await out.recordContext(client);
+    const groups = await out.groups(client);
+    out.doc.signatures = {};
+    for (const s of [this, ...others]) {
+      for (const [lh, box] of Object.entries(s.doc.signatures)) {
+        const g = groups.get(lh as Hex);
+        if (!g || g.kind === "unknown") continue;
+        const msg = await out.message(client, g);
+        for (const [kh, sig] of Object.entries(box)) {
+          if ((await out.signerOf(client, g, sig, msg)) === kh) out.add(g.lockHash, kh as Hex, sig);
+        }
+      }
+    }
+    return out;
+  }
+
+  /** The finalize rule: the first R members, then the lowest member indices up to M, in member order. */
+  async finalize(client: Client): Promise<Transaction> {
+    const verified = await this.merge(client);
+    const tx = this.template();
+    for (const g of (await verified.groups(client)).values()) {
+      const have = verified.doc.signatures[g.lockHash] ?? {};
+      const w = tx.getWitnessArgs(g.inputs[0]) ?? WitnessArgs.from({});
+      if (g.kind === "multisig") {
+        const cfg = verified.doc.multisig_configs[hexFrom(bytesFrom(g.script.args).slice(0, 20))];
+        const idx = Object.keys(have).map((k) => cfg.public_key_hashes.indexOf(k as Hex)).sort((a, b) => a - b);
+        const required = Array.from({ length: cfg.require_first_n }, (_, i) => i);
+        if (!required.every((i) => idx.includes(i)) || idx.length < cfg.threshold) {
+          throw new Error(`group ${g.lockHash} isn't ready`);
+        }
+        const pick = [...required, ...idx.filter((i) => i >= cfg.require_first_n)].slice(0, cfg.threshold);
+        w.lock = MultisigCkbWitness.from({
+          publicKeyHashes: cfg.public_key_hashes,
+          threshold: cfg.threshold,
+          mustMatch: cfg.require_first_n,
+          signatures: pick.sort((a, b) => a - b).map((i) => have[cfg.public_key_hashes[i]]),
+        }).toHex();
+      } else if (g.kind === "sighash") {
+        const sig = Object.values(have)[0];
+        if (!sig) throw new Error(`single-key group ${g.lockHash} has no signature`);
+        w.lock = sig;
+      } else {
+        throw new Error(`group ${g.lockHash} has a lock Sigsheet v1 doesn't sign`);
+      }
+      tx.setWitnessArgs(g.inputs[0], w);
+    }
+    return tx;
+  }
+}
