+// Path A on top of path C (X6): the building-packet profile, as an extra layer over the Sigsheet module, so the
+// cost of A beyond C can be measured. Throwaway experiment code. Profile rules: experiments/prototypes/fmt_a.py.
+import { bytesFrom } from "../bytes/index.js";
+import { CellOutput, Transaction, WitnessArgs } from "../ckb/index.js";
+import { JsonRpcTransformers } from "../client/jsonRpc/transformers.js";
+import { Codec } from "../codec/index.js";
+import { hashCkb } from "../hasher/index.js";
+import { Hex, hexFrom } from "../hex/index.js";
+import { mol } from "../molecule/index.js";
+import type { SigsheetJson } from "./index.js";
+
+const fixed = (n: number): Codec<Hex, Hex> =>
+  Codec.from({ byteLength: n, encode: (v: Hex) => bytesFrom(v), decode: (b) => hexFrom(b) });
+const Action = mol.table({ scriptInfoHash: mol.Byte32, scriptHash: mol.Byte32, data: mol.Bytes });
+const ScriptInfo = mol.table({
+  name: mol.String, url: mol.String, scriptHash: mol.Byte32, schema: mol.String, messageType: mol.String,
+});
+const BuildingPacketV1 = mol.table({
+  message: mol.table({ actions: mol.vector(Action) }),
+  payload: Transaction,
+  resolvedInputs: mol.table({ outputs: mol.vector(CellOutput), outputsData: mol.BytesVec }),
+  changeOutput: mol.Uint32Opt,
+  scriptInfos: mol.vector(ScriptInfo),
+  lockActions: mol.vector(Action),
+});
+const BuildingPacket = mol.union({ BuildingPacketV1 });
+const MultisigAction = mol.table({
+  config: mol.table({ requireFirstN: mol.Uint8, threshold: mol.Uint8, signerPubkeyHashes: mol.vector(fixed(20)) }),
+  signed: mol.vector(mol.struct({ pubkeyHash: fixed(20), signature: fixed(65) })),
+  inputTransactions: mol.vector(Transaction),
+});
+const SCHEMA = [
+  "array PubkeyHash [byte; 20];", "vector PubkeyHashVec <PubkeyHash>;", "table MultisigConfig {",
+  "    require_first_n: byte,", "    threshold: byte,", "    signer_pubkey_hashes: PubkeyHashVec,", "}",
+  "array Signature [byte; 65];", "struct PubkeyHashSignaturePair {", "    pubkey_hash: PubkeyHash,",
+  "    signature: Signature,", "}", "vector PubkeyHashSignaturePairVec <PubkeyHashSignaturePair>;",
+  "vector TransactionVec <Transaction>;", "table MultisigAction {", "    config: MultisigConfig,",
+  "    signed: PubkeyHashSignaturePairVec,", "    input_transactions: TransactionVec,", "}",
+].join("\n");
+const URL = "https://github.com/nervosnetwork/ckb-system-scripts/blob/master/c/secp256k1_blake160_multisig_all.c";
+
+function scriptInfo(codeHash: Hex, hashType: string) {
+  const scriptHash = hashCkb(mol.table({ c: mol.Byte32, h: mol.Uint8, a: mol.Bytes }).encode({
+    c: codeHash, h: { data: 0, type: 1, data1: 2, data2: 4 }[hashType]!, a: "0x" }));
+  return { name: "secp256k1_blake160_multisig_all", url: URL, scriptHash, schema: SCHEMA, messageType: "MultisigAction" };
+}
+
+/** C -> A. `multisigLockHashes` lists the multisig groups in order of first input (Sigsheet.groups). */
+export function sigsheetToBuildingPacket(doc: SigsheetJson, groups: { lockHash: Hex; kind: string; inputs: number[];
+  codeHash: Hex; hashType: string; args: Hex }[]): Hex {
+  const tx = JsonRpcTransformers.transactionTo(doc.transaction);
+  for (const g of groups.filter((x) => x.kind === "sighash")) {
+    const sig = Object.values(doc.signatures[g.lockHash] ?? {})[0];
+    if (!sig) continue;
+    const w = tx.getWitnessArgs(g.inputs[0]) ?? WitnessArgs.from({});
+    w.lock = sig;
+    tx.setWitnessArgs(g.inputs[0], w);
+  }
+  const spent = doc.transaction.inputs.map((i) =>
+    JsonRpcTransformers.cellOutputTo(doc.context[i.previous_output.tx_hash].outputs[Number(i.previous_output.index)]));
+  const prevs = Object.keys(doc.context).sort().map((h) => JsonRpcTransformers.transactionTo({ ...doc.context[h], witnesses: [] }));
+  const ms = groups.filter((x) => x.kind === "multisig");
+  const infos = new Map<Hex, ReturnType<typeof scriptInfo>>();
+  for (const g of ms) {
+    const si = scriptInfo(g.codeHash, g.hashType);
+    infos.set(hashCkb(ScriptInfo.encode(si)), si);
+  }
+  const lockActions = ms.map((g, n) => {
+    const cfg = doc.multisig_configs[g.args.slice(0, 42)];
+    const signed = Object.entries(doc.signatures[g.lockHash] ?? {}).sort(([a], [b]) => (a < b ? -1 : 1))
+      .map(([pubkeyHash, signature]) => ({ pubkeyHash: pubkeyHash as Hex, signature }));
+    const data = MultisigAction.encode({
+      config: { requireFirstN: cfg.require_first_n, threshold: cfg.threshold, signerPubkeyHashes: cfg.public_key_hashes },
+      signed, inputTransactions: n === 0 ? prevs : [] });
+    return { scriptInfoHash: hashCkb(ScriptInfo.encode(scriptInfo(g.codeHash, g.hashType))), scriptHash: g.lockHash, data };
+  });
+  return hexFrom(BuildingPacket.encode({ type: "BuildingPacketV1", value: {
+    message: { actions: [] }, payload: tx,
+    resolvedInputs: { outputs: spent, outputsData: spent.map(() => "0x") },
+    changeOutput: undefined,
+    scriptInfos: [...infos.keys()].sort().map((k) => infos.get(k)!),
+    lockActions } }));
+}
+
+/** A -> the parts C needs, with the profile's checks. The caller rebuilds and compares (canonical form). */
+export function buildingPacketToParts(bytes: Hex) {
+  const p = BuildingPacket.decode(bytes);
+  if (p.type !== "BuildingPacketV1") throw new Error("not BuildingPacketV1");
+  const v = p.value;
+  if (v.message.actions.length > 0) throw new Error("profile: message must be empty");
+  if (v.changeOutput !== undefined) throw new Error("profile: change_output must be None");
+  const actions = v.lockActions.map((a) => ({ ...a, action: MultisigAction.decode(a.data) }));
+  const prevs = actions[0]?.action.inputTransactions ?? [];
+  for (let i = 0; i < v.payload.inputs.length; i++) {
+    const op = v.payload.inputs[i].previousOutput;
+    const prev = prevs.find((t) => t.hash() === op.txHash);
+    if (!prev) throw new Error("profile: an input's previous transaction is missing");
+    if (hexFrom(prev.outputs[Number(op.index)].toBytes()) !== hexFrom(v.resolvedInputs.outputs[i].toBytes())) {
+      throw new Error("profile: resolved_inputs.outputs differs from the carried previous transaction");
+    }
+  }
+  return { payload: v.payload as Transaction, prevs, actions };
+}
