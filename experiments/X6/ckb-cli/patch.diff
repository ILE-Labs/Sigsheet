+impl TxSubCommand<'_> {
+    fn process_sigsheet(&mut self, name: &str, m: &ArgMatches) -> Result<Output, String> {
+        let read = |p: &str| Sigsheet::read(&fs::read_to_string(p).map_err(|e| e.to_string())?);
+        match name {
+            "sigsheet-sign" => {
+                let file = m.value_of("sigsheet").unwrap();
+                let mut sheet = read(file)?;
+                let privkey_opt: Option<PrivkeyWrapper> =
+                    PrivkeyPathParser.from_matches_opt(m, "privkey-path")?;
+                let mut signer = if let Some(privkey) = privkey_opt {
+                    get_privkey_signer(privkey)
+                } else {
+                    let account: H160 = FixedHashParser::<H160>::default().from_matches(m, "from-account")?;
+                    let password = if self.plugin_mgr.keystore_require_password() {
+                        Some(read_password(false, None)?)
+                    } else {
+                        None
+                    };
+                    let client = HttpRpcClient::new(self.rpc_client.url().to_owned());
+                    get_keystore_signer(self.plugin_mgr.keystore_handler(), client, account, password)
+                };
+                let added = sheet.sign(&mut signer)?;
+                fs::write(m.value_of("output").unwrap_or(file), sheet.to_text()).map_err(|e| e.to_string())?;
+                Ok(Output::new_output(serde_json::json!({ "signatures_added": added })))
+            }
+            "sigsheet-merge" => {
+                let sheets = m.values_of("sigsheet").unwrap().map(read).collect::<Result<Vec<_>, _>>()?;
+                let merged = sheets[0].merge(&sheets[1..])?;
+                fs::write(m.value_of("output").unwrap(), merged.to_text()).map_err(|e| e.to_string())?;
+                Ok(Output::new_output(serde_json::json!({ "merged": sheets.len() })))
+            }
+            _ => {
+                let tx = read(m.value_of("sigsheet").unwrap())?.finalize()?;
+                if let Some(out) = m.value_of("output") {
+                    let json = serde_json::to_string_pretty(&json_types::Transaction::from(tx.data()))
+                        .map_err(|e| e.to_string())?;
+                    fs::write(out, json).map_err(|e| e.to_string())?;
+                    return Ok(Output::new_output(serde_json::json!({ "tx_hash": tx.hash().to_string() })));
+                }
+                let resp = self
+                    .rpc_client
+                    .send_transaction(tx.data(), Some(json_types::OutputsValidator::Passthrough))
+                    .map_err(|err| format!("Send transaction error: {}", err))?;
+                Ok(Output::new_output(resp))
+            }
+        }
+    }
