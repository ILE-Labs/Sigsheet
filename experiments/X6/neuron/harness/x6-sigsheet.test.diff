+import { parseSigsheet, sigsheetToNeuron, addNeuronSignatures, sigsheetCanonicalJson } from '../../src/utils/sigsheet'
+
+// Env: SIGSHEET_IN, SIGSHEET_OUT (files), SIGNER_SECRET, SIGNER_BLAKE160 (a fresh devnet test key)
+const fakeWallet = {
+  name: 'x6-wallet',
+  id: 'x6',
+  extendedKey: 'a',
+  keystore: new x6hd.Keystore(
+    { cipher: 'x', cipherparams: { iv: 'x' }, ciphertext: 'x', kdf: '1', kdfparams: { dklen: 1, n: 1, r: 1, p: 1, salt: '1' }, mac: '1' },
+    '0'
+  ),
+  isHardware: () => false,
+}
+
+describe('Neuron signs a Sigsheet file', () => {
+  beforeEach(() => {
+    stubbedGetWallet.mockReturnValue(fakeWallet)
+    ;(x6Dialog.showMessageBox as jest.Mock).mockResolvedValue({ response: 1 }) // ignore locks without a config
+  })
+  it('signs every multisig group the key belongs to', async () => {
+    const t0 = Date.now()
+    const doc = parseSigsheet(fs.readFileSync(process.env.SIGSHEET_IN!, 'utf8'))
+    const { tx, context, configs } = sigsheetToNeuron(doc, fakeWallet.id)
+    const sender = new X6TransactionSender()
+    sender.getAddressInfos = jest.fn().mockReturnValue([
+      { walletId: fakeWallet.id, path: `m/44'/309'/0'/0/0`, blake160: process.env.SIGNER_BLAKE160, version: 'testnet' },
+    ]) as any
+    sender.getPrivateKeys = jest.fn().mockReturnValue([{ path: `m/44'/309'/0'/0/0`, privateKey: process.env.SIGNER_SECRET }]) as any
+    const signed = await sender.signMultisig(fakeWallet.id, tx, 'x', configs, context as any)
+    const out = addNeuronSignatures(doc, signed)
+    fs.writeFileSync(process.env.SIGSHEET_OUT!, sigsheetCanonicalJson(out))
+    fs.writeFileSync(process.env.SIGSHEET_OUT! + '.neuron.json', JSON.stringify({ ms: Date.now() - t0, signatures: signed.signatures, dialogs: (x6Dialog.showMessageBox as jest.Mock).mock.calls.length }))
+  })
+})
