+// ---------------------------------------------------------------- X1: Neuron reading ckb-cli tx files
+// Runs Neuron's own parseMultisigTxJsonFromCkbCli (utils/multisig.ts lines 41-58) on ckb-cli's real tx
+// files from this experiment, then the lock-hash check of MultisigController.loadMultisigTxJson
+// (controllers/multisig.ts lines 280-286), which compares every input's lockHash with the multisig
+// address the user opened.
+import { parseMultisigTxJsonFromCkbCli as x1ParseCkbCli } from '../../src/utils/multisig'
+import { computeScriptHash as x1ScriptHash } from '@ckb-lumos/lumos/utils'
+
+describe('X1 Neuron imports ckb-cli tx files', () => {
+  const result: any = {}
+  afterAll(() => {
+    fs.writeFileSync(OUT.replace(/\.json$/, '-ckbcli-import.json'), JSON.stringify(result, null, 1))
+  })
+  for (const id of ['S1-genesis-2of3', 'S3-v2-2of3-two-inputs']) {
+    it(id, () => {
+      const file = path.join(CASES, '..', 'results', 'ckb-cli', `${id}.json`)
+      const ckbcli = JSON.parse(fs.readFileSync(file, 'utf8'))
+      const c = JSON.parse(fs.readFileSync(path.join(CASES, `${id}.json`), 'utf8'))
+      const g = c.groups[0]
+      const realLockHash = x1ScriptHash({ codeHash: g.lock.code_hash, hashType: g.lock.hash_type, args: g.lock.args } as any)
+      const tx = x1ParseCkbCli(ckbcli as any)
+      const r: any = (result[id] = {})
+      r.ckbcli_file_signatures = ckbcli.signatures
+      r.neuron_signatures_after_import = tx.signatures
+      r.neuron_input_locks = tx.inputs.map((i: any) => ({ codeHash: i.lock?.codeHash, hashType: i.lock?.hashType, args: i.lock?.args, lockHash: i.lockHash }))
+      r.real_input_lock = g.lock
+      r.real_lock_hash = realLockHash
+      // loadMultisigTxJson rejects the file when every input's lockHash differs from the opened multisig's.
+      r.loadMultisigTxJson_rejects = tx.inputs.every((v: any) => v.lockHash && v.lockHash !== realLockHash)
+    })
+    it(`${id}: sign after import`, async () => {
+      // The UI then sends the transaction back over IPC as JSON, and signMultisig rebuilds it with
+      // Transaction.fromObject, which recomputes each input's lockHash from its lock.
+      const file = path.join(CASES, '..', 'results', 'ckb-cli', `${id}.json`)
+      const c = JSON.parse(fs.readFileSync(path.join(CASES, `${id}.json`), 'utf8'))
+      const g = c.groups[0]
+      const tx = JSON.parse(JSON.stringify(x1ParseCkbCli(JSON.parse(fs.readFileSync(file, 'utf8')) as any)))
+      const cfg = X1MultisigConfigModel.fromObject({
+        walletId: fakeWallet.id, r: g.multisig.require_first_n, m: g.multisig.threshold,
+        n: g.multisig.key_hashes.length, blake160s: g.multisig.key_hashes, lockCodeHash: g.lock.code_hash,
+      })
+      const k = g.signers[0]
+      stubbedGetWallet.mockReturnValue(fakeWallet)
+      ;(x1Dialog.showMessageBox as jest.Mock).mockClear()
+      ;(x1Dialog.showMessageBox as jest.Mock).mockResolvedValue({ response: 1 })
+      const sender = new X1TransactionSender()
+      sender.getAddressInfos = jest.fn().mockReturnValue([
+        { walletId: fakeWallet.id, path: `m/44'/309'/0'/0/0`, blake160: KEYS[k].blake160, version: 'testnet' },
+      ]) as any
+      sender.getPrivateKeys = jest.fn().mockReturnValue([{ path: `m/44'/309'/0'/0/0`, privateKey: KEYS[k].secret }]) as any
+      const r: any = result[id]
+      try {
+        const signed = await sender.signMultisig(fakeWallet.id, tx, 'x', [cfg])
+        r.sign_after_import = {
+          signer: k,
+          signatures_map: signed.signatures,
+          witness0: signed.witnesses[0] instanceof X1WitnessArgs ? { lock: (signed.witnesses[0] as any).lock } : signed.witnesses[0],
+          unrecognised_lock_dialogs: (x1Dialog.showMessageBox as jest.Mock).mock.calls.length,
+        }
+      } catch (e: any) {
+        r.sign_after_import = { signer: k, error: String(e && e.message ? e.message : e) }
+      }
+    })
+  }
+})
