+// ---------------------------------------------------------------- X1 harness (not from Neuron)
+// The original test imports these right after its mocks (its lines 191-193); the mocks above use them.
+import CellDep, { DepType } from '../../src/models/chain/cell-dep'
+import OutPoint from '../../src/models/chain/out-point'
+void bytes
+void resetMocks
+void dialog
+export type X1Unused = CKBComponents.RawTransaction
+import fs from 'fs'
+import path from 'path'
+import { dialog as x1Dialog } from 'electron'
+import { hd as x1hd } from '@ckb-lumos/lumos'
+import { CKBHasher } from '@ckb-lumos/lumos/utils'
+import X1Transaction from '../../src/models/chain/transaction'
+import X1CellDep from '../../src/models/chain/cell-dep'
+import X1OutPoint from '../../src/models/chain/out-point'
+import X1Input from '../../src/models/chain/input'
+import X1Script from '../../src/models/chain/script'
+import X1Output from '../../src/models/chain/output'
