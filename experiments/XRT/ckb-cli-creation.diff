+    /// Creation inside ckb-cli (experiment XRT-4): a Sigsheet file for the transaction in ckb-cli's own `tx` file,
+    /// with each input's previous transaction (raw part) fetched from the node (the one step that needs it), the
+    /// first witness of each group it signs written as a template, and the multisig configs the groups use.
+    pub fn create(
+        transaction: json_types::Transaction,
+        configs: Vec<(H160, Config)>,
+        fetch: &mut dyn FnMut(&H256) -> Result<packed::Transaction, String>,
+    ) -> Result<Sigsheet, String> {
+        let mut context = BTreeMap::new();
+        for input in &transaction.inputs {
+            let h = input.previous_output.tx_hash.clone();
+            if context.contains_key(&h) {
+                continue;
+            }
+            let prev = json_types::Transaction::from(fetch(&h)?);
+            context.insert(h, RawTx {
+                cell_deps: prev.cell_deps,
+                header_deps: prev.header_deps,
+                inputs: prev.inputs,
+                outputs: prev.outputs,
+                outputs_data: prev.outputs_data,
+                version: prev.version,
+            });
+        }
+        let mut sheet = Sigsheet {
+            context,
+            multisig_configs: configs.into_iter().collect(),
+            signatures: BTreeMap::new(),
+            transaction,
+            version: "0x1".to_string(),
+        };
+        while sheet.transaction.witnesses.len() < sheet.transaction.inputs.len() {
+            sheet.transaction.witnesses.push(JsonBytes::default());
+        }
+        let groups = sheet.groups()?;
+        for g in &groups {
+            let i = g.idxs[0];
+            let w = sheet.transaction.witnesses[i].as_bytes().to_vec();
+            if w.is_empty() {
+                continue;
+            }
+            let wa = WitnessArgs::from_slice(&w).map_err(|e| e.to_string())?;
+            let tpl = wa.as_builder().lock(packed::BytesOpt::default()).build();
+            sheet.transaction.witnesses[i] = if tpl.input_type().is_none() && tpl.output_type().is_none() {
+                JsonBytes::default()
+            } else {
+                JsonBytes::from_bytes(tpl.as_bytes())
+            };
+        }
+        let used: HashSet<H160> = groups
+            .iter()
+            .filter(|g| matches!(g.kind, Kind::Multisig(_)))
+            .map(|g| H160::from_slice(&g.args[0..20]).unwrap())
+            .collect();
+        sheet.multisig_configs.retain(|k, _| used.contains(k));
+        for g in groups.iter().filter(|g| matches!(g.kind, Kind::Multisig(_))) {
+            sheet.config(g)?;
+        }
+        Ok(sheet)
+    }
